# Copy to .env to change the map tile provider used on Hitta oss.
# Leave unset to use CARTO Voyager (OpenStreetMap data). Use only ONE of the blocks below.

# MapTiler (replace YOUR_KEY, and restrict the key to your domain at maptiler.com):
# VITE_MAP_TILES=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>

# Stadia Maps (register your domain at stadiamaps.com):
# VITE_MAP_TILES=https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}{r}.png
# VITE_MAP_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
